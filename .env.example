CI_ENVIRONMENT=production
MCMS_BASE_URL=http://localhost:8080/
MCMS_HTTP_PORT=8080
MCMS_TIMEZONE=UTC

MCMS_DB_NAME=mcms
MCMS_DB_USER=mcms
MCMS_DB_PASSWORD=change-me
MCMS_DB_ROOT_PASSWORD=change-root-me

MCMS_MAIL_DOMAIN=example.test
MCMS_MAIL_HOSTNAME=mail.example.test
MCMS_MAIL_FROM=noreply@example.test
MCMS_MAIL_FROM_NAME=mCMS
MCMS_SMTP_RELAYHOST=
MCMS_SMTP_RELAY_USER=
MCMS_SMTP_RELAY_PASSWORD=
MCMS_DKIM_AUTOGENERATE=1
MCMS_DKIM_SELECTOR=mail

# First-run bootstrap. Set these only while creating the first superadmin,
# then remove MCMS_ADMIN_PASSWORD from the deployment environment.
MCMS_ADMIN_EMAIL=
MCMS_ADMIN_USERNAME=admin
MCMS_ADMIN_PASSWORD=
