{
  "name": "mirivlad/mcms",
  "description": "Self-hosted CMS and e-commerce engine based on CodeIgniter 4",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.2",
    "codeigniter4/framework": "4.7.4",
    "codeigniter4/shield": "^1.4",
    "codeigniter4/settings": "^2.4",
    "composer/semver": "^3.4"
  },
  "require-dev": {
    "fakerphp/faker": "^1.9",
    "mikey179/vfsstream": "^1.6",
    "phpunit/phpunit": "^10.5.16"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/",
      "MCMS\\Core\\": "src/Core/",
      "MCMS\\Modules\\": "modules/"
    },
    "exclude-from-classmap": [
      "**/Database/Migrations/**"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Support\\": "tests/_support"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
