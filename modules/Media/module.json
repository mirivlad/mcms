{
  "id": "media",
  "name": "@MCMS.media.title",
  "version": "0.2.2",
  "namespace": "MCMS\\Modules\\Media",
  "provider": "MCMS\\Modules\\Media\\Module",
  "mcms": "^0.1.6",
  "description": "@MCMS.modules.mediaDescription",
  "requires": [],
  "settings": {
    "max_upload_mb": 20,
    "max_image_megapixels": 40,
    "allowed_mime_types": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/gif",
      "application/pdf"
    ]
  },
  "permissions": {
    "media.view": "@MCMS.permissions.media_view",
    "media.upload": "@MCMS.permissions.media_upload",
    "media.edit": "@MCMS.permissions.media_edit",
    "media.delete": "@MCMS.permissions.media_delete",
    "media.settings": "@MCMS.permissions.media_settings"
  },
  "grants": {
    "admin": [
      "media.view",
      "media.upload",
      "media.edit",
      "media.delete",
      "media.settings"
    ]
  },
  "data_providers": {
    "media.usage": "MCMS\\Modules\\Media\\Api\\ThemeUsageProvider"
  }
}
